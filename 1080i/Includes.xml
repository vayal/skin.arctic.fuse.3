    <include file="Includes_Constants_21x9.xml" condition="String.IsEqual(Skin.AspectRatio,21:9)" />
    <include file="Includes_Constants.xml" />

    <include name="Furniture_Home_Menu">
        <control type="list" id="9000">
            <include>Object_Home_Menu_Config</include>
            <itemlayout height="80">
                <control type="label">
                    <left>0</left>
                    <width>100%</width>
                    <height>80</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>font_main_bold</font>
                    <textcolor>main_fg_70</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout height="80">
                <control type="label">
                    <left>0</left>
                    <width>100%</width>
                    <height>80</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>font_main_bold</font>
                    <textcolor>$VAR[ColorSelected]</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
            <content>
                <item>
                    <label>Home</label>
                    <onclick>ActivateWindow(Home)</onclick>
                </item>
                <item>
                    <label>Movies</label>
                    <onclick>ActivateWindow(Videos,plugin://plugin.video.velocity2/?action=hub_movies,return)</onclick>
                </item>
                <item>
                    <label>Series</label>
                    <onclick>ActivateWindow(Videos,plugin://plugin.video.velocity2/?action=hub_series,return)</onclick>
                </item>
            </content>
        </control>
    </include>

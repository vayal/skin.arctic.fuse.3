    <variable name="Label_Home_Menu_Movies"><value>Movies</value></variable>
    <variable name="Label_Home_Menu_Series"><value>Series</value></variable>

    <!-- Restored core home/settings includes (previously safety stubs). -->
    <include name="Home_Switcher_Horz">
        <include>Furniture_Home_Menu</include>
    </include>
    <include name="Home_Control">
        <param name="window">10000</param>
        <param name="overlay">false</param>
        <param name="onclick_condition">true</param>
        <definition>
            <control type="button" id="300">
                <height>200</height>
                <texturenofocus />
                <texturefocus />
                <onleft>SetFocus(300)</onleft>
                <onright>SetFocus(300)</onright>
                <onfocus>SetProperty(HomeSwitcher.IsVisible,True,Home)</onfocus>
                <onfocus condition="$PARAM[overlay]">SetProperty(InfoPanel.FullSwitch,Wall,Home)</onfocus>
                <onfocus condition="![$PARAM[overlay]]">ClearProperty(InfoPanel.FullSwitch,Home)</onfocus>
                <onfocus condition="$PARAM[overlay]">SetProperty(Background.ShowOverlay,True,Home)</onfocus>
                <onfocus condition="![$PARAM[overlay]]">ClearProperty(Background.ShowOverlay,Home)</onfocus>
                <onclick condition="$PARAM[onclick_condition] + !String.IsEmpty(Skin.String(HomeSwitcher.$PARAM[window].Shortcut.Target))">ActivateWindow($INFO[Skin.String(HomeSwitcher.$PARAM[window].Shortcut.Target)],$INFO[Skin.String(HomeSwitcher.$PARAM[window].Shortcut.Path)],return)</onclick>
                <onclick condition="$PARAM[onclick_condition] + String.IsEmpty(Skin.String(HomeSwitcher.$PARAM[window].Shortcut.Target))">$INFO[Skin.String(HomeSwitcher.$PARAM[window].Shortcut.Path)]</onclick>
                <nested />
            </control>
            <control type="image">
                <visible>!String.IsEmpty(Window(Home).Property(HomeSwitcher.IsVisible))</visible>
                <texture colordiffuse="main_bg_70">background/combined_topmenu.png</texture>
                <bottom>0</bottom>
            </control>
        </definition>
    </include>
    <include name="Home_Info_Animation">
        <animation effect="fade" start="0" end="100" time="400" delay="200" tween="cubic" easing="in">Visible</animation>
    </include>
    <include name="Home_Slide_Animation">
        <animation effect="slide" start="0,-200" end="0" time="400" tween="cubic" easing="out" reversible="false" condition="!String.IsEmpty(Window(Home).Property(HomeSwitcher.IsVisible))">Conditional</animation>
        <animation effect="slide" end="0,-200" start="0" delay="100" time="400" tween="cubic" easing="out" reversible="false" condition="String.IsEmpty(Window(Home).Property(HomeSwitcher.IsVisible))">Conditional</animation>
    </include>
    <include name="Settings_InfoText">
        <include content="Part_InfoText">
            <param name="id">6</param>
            <param name="label">$VAR[Label_Settings_InfoText]</param>
            <param name="fallback">$INFO[System.BuildVersion,Kodi ,]$INFO[System.AddonVersion(skin.velocity.af3), • AF3 v,]</param>
            <param name="colordiffuse">main_fg_70</param>
            <param name="include_hintlabel">false</param>
        </include>
    </include>

    <include file="Includes_Constants_FlixArt_Large.xml" condition="Skin.String(Skin.FlixArt.Size,Large)" />
    <include file="Includes_Constants_FlixArt_ExtraLarge.xml" condition="Skin.String(Skin.FlixArt.Size,ExtraLarge)" />
    <include file="Includes_Constants_4x3.xml" condition="String.IsEqual(Skin.AspectRatio,4:3)" />

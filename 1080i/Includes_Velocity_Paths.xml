<!--
  Velocity Plugin Path Wrappers
  Centralized URL variables for plugin.video.velocity2 actions
  Use these instead of hardcoded plugin://plugin.video.velocity2/?... strings
-->

<!-- Home -->
<variable name="Velocity.Path.Home" value="plugin://plugin.video.velocity2/?action=home" />

<!-- Discovery -->
<variable name="Velocity.Path.Discover" value="plugin://plugin.video.velocity2/?action=discover" />

<!-- Search Hub (entry screen) -->
<variable name="Velocity.Path.SearchHub" value="plugin://plugin.video.velocity2/?action=search_hub" />

<!-- Execute Search (base with query append) -->
<variable name="Velocity.Path.ExecuteSearch" value="plugin://plugin.video.velocity2/?action=execute_search" />

<!-- List Base (browse/list) -->
<variable name="Velocity.Path.ListBase" value="plugin://plugin.video.velocity2/?action=list" />

<!-- Smart List Base -->
<variable name="Velocity.Path.SmartListBase" value="plugin://plugin.video.velocity2/?action=smart_list" />

<!-- View Show Base -->
<variable name="Velocity.Path.ViewShowBase" value="plugin://plugin.video.velocity2/?action=view_show" />

<!-- View Season Base -->
<variable name="Velocity.Path.ViewSeasonBase" value="plugin://plugin.video.velocity2/?action=view_season" />

<!-- Play Base -->
<variable name="Velocity.Path.PlayBase" value="plugin://plugin.video.velocity2/?action=play" />

<!-- Select Base (alternative to play) -->
<variable name="Velocity.Path.SelectBase" value="plugin://plugin.video.velocity2/?action=select" />
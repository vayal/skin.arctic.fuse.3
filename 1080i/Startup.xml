<?xml version="1.0" encoding="UTF-8"?>
<window>
    <onload condition="Skin.HasSetting(SkinUserLogin.StartupLoginScreen) + !Skin.HasSetting(SkinUserLogin.Disabled) + String.IsEmpty(Window(Home).Property(StartupReplaceWindow))">SetProperty(StartupReplaceWindow,1195,Home)</onload>
    <onload>SetProperty(SplashIsVisible,True,1198)</onload>
    <!-- Explicit hh:mm:ss: long safety noop only; real dismiss is skinvariables-splash + Home splash safety -->
    <onload>AlarmClock(SplashTimeOut,noop,01:00:00,silent)</onload>
    <onload>SetProperty(InitStatus,$LOCALIZE[31145],1198)</onload>
    <onload>Skin.SetString(HomeSwitcher.Home.Mode,Standard)</onload>
    <onload>Skin.SetString(HomeSwitcher.1101.Mode,Standard)</onload>
    <onload>Skin.SetString(HomeSwitcher.1102.Mode,Standard)</onload>
    <onload>Skin.SetString(HomeSwitcher.1101.Toggle,true)</onload>
    <onload>Skin.SetString(HomeSwitcher.1102.Toggle,true)</onload>
    <onload>Skin.SetString(HomeSwitcher.1101.Name,Series)</onload>
    <onload>Skin.SetString(HomeSwitcher.1102.Name,Movies)</onload>
    <onload>Skin.SetString(HomeSwitcher.1101.Shortcut.Target,videos)</onload>
    <onload>Skin.SetString(HomeSwitcher.1101.Shortcut.Path,plugin://plugin.video.velocity2/?action=tv_hub)</onload>
    <onload>Skin.SetString(HomeSwitcher.1102.Shortcut.Target,videos)</onload>
    <onload>Skin.SetString(HomeSwitcher.1102.Shortcut.Path,plugin://plugin.video.velocity2/?action=movies_hub)</onload>
    <onload>Skin.SetString(HomeSwitcher.Home.Spotlight.Target,videos)</onload>
    <onload>Skin.SetString(HomeSwitcher.Home.Spotlight.Path,plugin://plugin.video.velocity2/?action=list&amp;list_id=home_spotlight_mixed&amp;page=1)</onload>
    <onload>Skin.SetString(HomeSwitcher.Home.Spotlight.Label,Home Spotlight)</onload>
    <onload>Skin.SetString(HomeSwitcher.1101.Spotlight.Target,videos)</onload>
    <onload>Skin.SetString(HomeSwitcher.1101.Spotlight.Path,plugin://plugin.video.velocity2/?action=list&amp;list_id=series_spotlight_trending&amp;page=1)</onload>
    <onload>Skin.SetString(HomeSwitcher.1101.Spotlight.Label,Series Spotlight)</onload>
    <onload>Skin.SetString(HomeSwitcher.1102.Spotlight.Target,videos)</onload>
    <onload>Skin.SetString(HomeSwitcher.1102.Spotlight.Path,plugin://plugin.video.velocity2/?action=list&amp;list_id=movies_spotlight_trending&amp;page=1)</onload>
    <onload>Skin.SetString(HomeSwitcher.1102.Spotlight.Label,Movies Spotlight)</onload>
    <onload condition="!String.IsEmpty(Window(Home).Property(StartupReplaceWindow))">ReplaceWindow($INFO[Window(Home).Property(StartupReplaceWindow)])</onload>
    <onload condition="String.IsEmpty(Window(Home).Property(StartupReplaceWindow))">ReplaceWindow(Home)</onload>
    <!-- skinvariables-splash.json is otherwise unreachable (only self-routes); one-shot delayed RunScript after Home can mount -->
    <onload condition="String.IsEmpty(Window(Home).Property(StartupReplaceWindow))">AlarmClock(SplashVarsStart,RunScript(script.skinvariables,run_executebuiltin=special://skin/shortcuts/skinvariables-splash.json,use_rules=True),00:00:02,silent)</onload>
    <include>Action_ButtonMenu_Onload</include>

    <onunload>ClearProperty(StartupReplaceWindow,Home)</onunload>
</window>
<?xml version="1.0" encoding="UTF-8"?>
<window>
    <onload>RunScript(script.skinvariables,run_executebuiltin=special://skin/shortcuts/skinvariables-splash.json,use_rules=True)</onload>
    <include>Action_BuildViews</include>
    <onload>Skin.SetString(TMDbHelper.Corner.Radius,20)</onload>
    <onload>Skin.SetString(TMDbHelper.UseLocalWindowIDs,10000|11101|11102|11103|11104|11105|11106|11107|11108|11109)</onload>
    <include>Action_ButtonMenu_Onload</include>
    <include>Action_BuildShortcuts_OnLoad</include>

    <include content="Hub_Onload">
        <param name="window_id">Home</param>
    </include>
    <onload condition="String.IsEqual(Skin.String(HomeSwitcher.Home.Spotlight.Path),plugin://plugin.video.velocity2/?action=home)">Skin.SetString(HomeSwitcher.Home.Spotlight.Path,plugin://plugin.video.velocity2/?action=list&amp;list_id=home_spotlight_mixed&amp;page=1)</onload>
    <onload condition="String.IsEqual(Skin.String(HomeSwitcher.Home.Spotlight.Label),Velocity)">Skin.SetString(HomeSwitcher.Home.Spotlight.Label,Spotlight)</onload>
    <onload condition="String.IsEmpty(Skin.String(HomeSwitcher.Home.Spotlight.Target))">Skin.SetString(HomeSwitcher.Home.Spotlight.Path,plugin://plugin.video.velocity2/?action=list&amp;list_id=home_spotlight_mixed&amp;page=1)</onload>
    <onload condition="String.IsEmpty(Skin.String(HomeSwitcher.Home.Spotlight.Target))">Skin.SetString(HomeSwitcher.Home.Spotlight.Target,videos)</onload>
    <onload condition="String.IsEmpty(Skin.String(HomeSwitcher.Home.Spotlight.Label))">Skin.SetString(HomeSwitcher.Home.Spotlight.Label,Spotlight)</onload>
    <onload condition="!String.IsEmpty(Skin.String(HomeSwitcher.Home.Spotlight.Target)) + [String.Contains(Skin.String(HomeSwitcher.Home.Spotlight.Path),action=discover) | String.Contains(Skin.String(HomeSwitcher.Home.Spotlight.Path),smart_list)]">Skin.SetString(HomeSwitcher.Home.Spotlight.Path,plugin://plugin.video.velocity2/?action=list&amp;list_id=home_spotlight_mixed&amp;page=1)</onload>
    <!-- Hub_Onload runs above before Target/Path may be seeded; it can leave WidgetContainer at 501. Re-point to spotlight feeder once Target exists. -->
    <onload condition="!String.IsEmpty(Skin.String(HomeSwitcher.Home.Spotlight.Target))">SetProperty(TMDbHelper.WidgetContainer,301)</onload>

    <!-- Home §2.1 in-progress tabs: seed WidgetMeta + restore last tab (skin-vision-blueprint-v0 §2.2). -->
    <onload condition="String.IsEmpty(Skin.String(Velocity.Home.InProgressTab))">Skin.SetString(Velocity.Home.InProgressTab,series)</onload>
    <onload condition="String.IsEqual(Skin.String(Velocity.Home.InProgressTab),movies)">SetProperty(WidgetMeta.501.FolderPath,plugin://plugin.video.velocity2/?action=list&amp;list_id=home_in_progress_movies&amp;page=1)</onload>
    <onload condition="!String.IsEqual(Skin.String(Velocity.Home.InProgressTab),movies)">SetProperty(WidgetMeta.501.FolderPath,plugin://plugin.video.velocity2/?action=list&amp;list_id=home_in_progress_series&amp;page=1)</onload>
    <onload condition="String.IsEqual(Skin.String(HomeSwitcher.Home.Mode),Standard) + String.IsEqual(Skin.String(Velocity.Home.InProgressTab),movies)">AlarmClock(velocityhomeiptab501,SetFocus(501,1),00:02,silent)</onload>
    <onload condition="[String.IsEqual(Skin.String(HomeSwitcher.Home.Mode),Wall) | String.IsEqual(Skin.String(HomeSwitcher.Home.Mode),Combined)] + String.IsEqual(Skin.String(Velocity.Home.InProgressTab),movies)">AlarmClock(velocityhomeiptab601,SetFocus(601,1),00:02,silent)</onload>

    <onunload condition="String.Contains(Window.Property(WidgetMeta.501.FolderPath),home_in_progress_movies)">Skin.SetString(Velocity.Home.InProgressTab,movies)</onunload>
    <onunload condition="!String.IsEmpty(Window.Property(WidgetMeta.501.FolderPath)) + !String.Contains(Window.Property(WidgetMeta.501.FolderPath),home_in_progress_movies)">Skin.SetString(Velocity.Home.InProgressTab,series)</onunload>

    <onload condition="!Skin.HasSetting(Home.FirstRun)">Skin.SetBool(Hub.Home.DisableSubmenu)</onload>
    <onload condition="!Skin.HasSetting(Home.FirstRun)">Skin.SetString(Shortcuts.RebuildDateTime,FirstRun)</onload>
    <onload condition="!Skin.HasSetting(Home.FirstRun)">Skin.SetBool(Home.FirstRun)</onload>
    <onload condition="!Skin.HasSetting(Home.FirstRun)">AlarmClock(reloadskin,ReloadSkin(),00:00,silent)</onload>

    <onload>$VAR[Action_RatingsMonitor]</onload>

    <onload condition="Skin.HasSetting(Home.FirstRun) + String.IsEmpty(Window(1198).Property(FirstStart))">$VAR[Action_FirstStart_HomeFocus]</onload>
    <onload condition="Skin.HasSetting(Home.FirstRun) + String.IsEmpty(Window(1198).Property(FirstStart))">SetProperty(FirstStart,True,1198)</onload>

    <controls>
        <include content="Hub_Window">
            <param name="window">home</param>
            <param name="skin_key">Home</param>
            <param name="velocity_spotlight_list_id">home_spotlight_mixed</param>
        </include>
    </controls>
</window>
